<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 180 180" width="180" height="180">
  <defs>
    <linearGradient id="gradient1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#3B82F6"/>
      <stop offset="30%" style="stop-color:#8B5CF6"/>
      <stop offset="70%" style="stop-color:#EC4899"/>
      <stop offset="100%" style="stop-color:#F59E0B"/>
    </linearGradient>
    <linearGradient id="gradient2" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#06B6D4"/>
      <stop offset="100%" style="stop-color:#3B82F6"/>
    </linearGradient>
  </defs>
  
  <!-- Rounded rectangle background -->
  <rect x="0" y="0" width="180" height="180" rx="39" ry="39" fill="url(#gradient1)"/>
  
  <!-- Code brackets -->
  <path d="M40 60 L25 75 L25 105 L40 120" stroke="white" stroke-width="8" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
  <path d="M140 60 L155 75 L155 105 L140 120" stroke="white" stroke-width="8" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
  
  <!-- Central cube/M design -->
  <g transform="translate(90, 90)">
    <!-- Main geometric shape -->
    <polygon points="-25,-20 0,-35 25,-20 25,20 0,35 -25,20" fill="url(#gradient2)" stroke="white" stroke-width="4"/>
    <!-- Inner structure lines -->
    <path d="M0 -35 L0 0 M-25 -20 L0 0 M25 -20 L0 0" stroke="white" stroke-width="3" opacity="0.8"/>
    <!-- Center dot -->
    <circle cx="0" cy="0" r="4" fill="white"/>
  </g>
  
  <!-- Decorative elements -->
  <circle cx="60" cy="40" r="4" fill="white" opacity="0.7"/>
  <circle cx="120" cy="40" r="4" fill="white" opacity="0.7"/>
  <circle cx="60" cy="140" r="4" fill="white" opacity="0.7"/>
  <circle cx="120" cy="140" r="4" fill="white" opacity="0.7"/>
  
  <!-- Additional tech elements -->
  <rect x="70" y="25" width="40" height="3" fill="white" opacity="0.4" rx="1.5"/>
  <rect x="70" y="152" width="40" height="3" fill="white" opacity="0.4" rx="1.5"/>
</svg>